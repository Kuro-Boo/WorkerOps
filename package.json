{
  "name": "workerops",
  "version": "1.0.6",
  "description": "Generic guardian Worker that fronts a Cloudflare Worker to make self-updates safe and reversible (deploy / health-verify / auto-revert / recovery UI).",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.txt",
  "author": "Kuro-Boo",
  "homepage": "https://github.com/Kuro-Boo/WorkerOps#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kuro-Boo/WorkerOps.git"
  },
  "bugs": {
    "url": "https://github.com/Kuro-Boo/WorkerOps/issues"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "self-update",
    "rollback",
    "deployment",
    "guardian",
    "watchdog",
    "workerops"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "PATH=\"$PWD/bin:$PATH\" wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test:bindings": "node src/bindings.test.ts",
    "test:sql": "node src/sql.test.ts",
    "test:verify": "esbuild src/verify.test.ts --bundle --platform=node --format=esm --outfile=.wrangler/verify-test.mjs && node .wrangler/verify-test.mjs",
    "test:trial": "esbuild src/trial.test.ts --bundle --platform=node --format=esm --outfile=.wrangler/trial-test.mjs && node .wrangler/trial-test.mjs",
    "test:release": "esbuild src/signed-release.test.ts --bundle --platform=node --format=esm --outfile=.wrangler/signed-release-test.mjs && node .wrangler/signed-release-test.mjs",
    "test:defects": "esbuild src/defects.test.ts --bundle --platform=node --format=esm --outfile=.wrangler/defects-test.mjs && node .wrangler/defects-test.mjs",
    "test:assets": "esbuild src/assets.test.ts --bundle --platform=node --format=esm --outfile=.wrangler/assets-test.mjs && node .wrangler/assets-test.mjs",
    "test:peer": "esbuild src/peer.test.ts --bundle --platform=node --format=esm --outfile=.wrangler/peer-test.mjs && node .wrangler/peer-test.mjs",
    "test:store": "esbuild src/store-release.test.ts --bundle --platform=node --format=esm --outfile=.wrangler/store-release-test.mjs && node .wrangler/store-release-test.mjs",
    "test:tick": "esbuild src/tick.test.ts --bundle --platform=node --format=esm --outfile=.wrangler/tick-test.mjs && node .wrangler/tick-test.mjs",
    "test:placement": "esbuild src/placement.test.ts --bundle --platform=node --format=esm --outfile=.wrangler/placement-test.mjs && node .wrangler/placement-test.mjs",
    "test:follow": "esbuild src/follow.test.ts --bundle --platform=node --format=esm --outfile=.wrangler/follow-test.mjs && node .wrangler/follow-test.mjs",
    "test:restart": "esbuild src/restart.test.ts --bundle --platform=node --format=esm --outfile=.wrangler/restart-test.mjs && node .wrangler/restart-test.mjs",
    "test:screen": "esbuild src/screen.test.ts --bundle --platform=node --format=esm --outfile=.wrangler/screen-test.mjs --external:cloudflare:workers && node .wrangler/screen-test.mjs",
    "test": "npm run test:bindings && npm run test:sql && npm run test:release && npm run test:defects && npm run test:assets && npm run test:peer && npm run test:store && npm run test:tick && npm run test:restart && npm run test:follow && npm run test:placement && npm run test:screen && npm run test:trial && npm run test:verify",
    "release:bundle": "esbuild src/index.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/worker.js --minify --external:cloudflare:workers",
    "release:publish": "./ops/publish-entamy-release.sh"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260510.0",
    "esbuild": "^0.27.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.14.0"
  }
}
