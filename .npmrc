# 依存の乗っ取りへの備え(2026-10-16)。npm は親フォルダの .npmrc を読まないので、パッケージごとに置く。
#
# ★導入時のスクリプトを動かさない。乗っ取られた依存は postinstall で .env や鍵を盗む(2026-08 の Shai-Hulud 型)。
#   esbuild・workerd・sharp・fsevents はスクリプト無しで動く。要るものは名指しで rebuild する。
#   この設定では `npm test` の pretest も飛ぶので、前処理は test から `npm run` で明示的に呼ぶ。
ignore-scripts=true
# ★公開から7日経っていない版を取らない。乗っ取られた版は数時間〜数日で見つかって取り下げられる。
min-release-age=7
